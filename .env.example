# Copy this file to .env and set a strong local PostgreSQL password.
# Docker Compose and the local Python application both read these values.
# Free Alpha Vantage API key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Local FastAPI address used when Streamlit runs on Windows outside Docker.
# Docker Compose overrides this with http://backend:8000 inside the frontend container.
BACKEND_URL=http://127.0.0.1:8000
# Safety buffer for slower research responses. The saved RAG index should make
# ordinary requests much faster than this limit.
BACKEND_TIMEOUT_SECONDS=90

# Azure OpenAI settings reused by the RAG pipeline. Ask your course/previous-project
# setup for the deployment names and keys; never commit the real .env file.
AZURE_ENDPOINT=
AZURE_API_KEY=
EMBED_DEPLOYMENT=
EMBED_API_VERSION=
CHAT_DEPLOYMENT=
CHAT_API_VERSION=

# Dense retrieval backend. Keep Chroma for local Docker development. In ECS,
# use opensearch with the VPC domain endpoint and the ECS task IAM role.
VECTOR_STORE=chroma
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=investment-research
OPENSEARCH_SERVICE=es
OPENSEARCH_TIMEOUT_SECONDS=60
OPENSEARCH_BULK_DOCUMENTS=20
AWS_REGION=eu-west-2

# Identifies this project politely when downloading public SEC filings.
# Put your real contact email only in .env, not in this example file.
SEC_USER_AGENT=

# Local Python uses localhost. Docker Compose overrides this with postgres inside
# the backend container, because containers communicate through service names.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=investment_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# simple change
